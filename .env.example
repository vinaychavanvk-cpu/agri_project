# Smart Agriculture Management System - Environment Variables
# Copy this file to .env for local development, or add these in your Vercel Project Settings.

# Option 1: Full Connection String (Recommended for Vercel, Neon, Supabase, Render, Railway)
# DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or Vercel Postgres integration:
# POSTGRES_URL=postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual variables (Recommended for local PostgreSQL)
DB_NAME=SmartAgricultureDB
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Application security and server config
SECRET_KEY=replace_with_your_own_secret_key_12345
FLASK_PORT=5001
FLASK_DEBUG=False
